# Template only: copy to .env.local (never commit real values) and set every value below.
# The contact API returns 503 and sends nothing if any required value is missing or invalid.

# Inbox that receives enquiries. Single address; always read server-side, never from the browser.
CONTACT_EMAIL_TO=jimtechai30@gmail.com

# SMTP (Gmail: smtp.gmail.com, port 465 = implicit TLS, password = a Google App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="JimTech Website <your-email@gmail.com>"

# Rate limiting (Upstash Redis REST). Required in production; the contact API fails closed
# (503) without them. Optional in local development, where the limiter is skipped.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Only for non-Vercel hosts behind a proxy that overwrites X-Forwarded-For. Leave unset on Vercel.
# CONTACT_TRUST_PROXY=true